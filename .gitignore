# offline bake artifacts: the COMPRESSED binaries (baked/*.bin.gz) + manifest
# ARE committed for GitHub Pages. The raw baked/*.bin are gitignored -- kept
# locally to regenerate the .gz via `node scripts/compress-baked.mjs`.
baked/*.bin
baked/shot-*.png
baked/status-*.txt

# OS noise
Thumbs.db
.DS_Store

# original Poly Haven downloads (huge; the 1k gltf conversions are committed)
assets/models/*.blend.zip
# node-side test shim for the vendored three module
node_modules/

# transient bench outputs + runtime scratch (regenerated by scripts/bench-*.mjs);
# the raw in-VR profiling data behind the write-up IS kept
baked/bench-*.json
baked/bench-summary.csv
baked/dyncheck.json
!baked/bench-quest-vr.json
